# Vidheya DevOps context
export CONTEXT_TYPE="vidheya"

# Remote node (values injected from registry at runtime)
export REMOTE_HOST="${REMOTE_HOST:-ubuntu@192.168.1.151}"
export REMOTE_REPO="${REMOTE_REPO:-~/repo/vidheya}"

# Kubernetes
export K8S_NAMESPACE="${K8S_NAMESPACE:-apps}"
export K8S_CLUSTER="${K8S_CLUSTER:-vidheya-k3s}"

# Proxmox
export PROXMOX_HOST="${PROXMOX_HOST:-192.168.1.10}"
