# WSCloudServices context — logical config only (no paths, no credentials)
export CONTEXT_TYPE="wscloudservices"

# Service URLs (ports injected by instance registry env block)
export SVC1_PORT="${SVC1_PORT:-8081}"
export SVC2_PORT="${SVC2_PORT:-8082}"
export FRONTEND_PORT="${FRONTEND_PORT:-3000}"
export SVC1_URL="http://localhost:${SVC1_PORT}"
export SVC2_URL="http://localhost:${SVC2_PORT}"
export FRONTEND_URL="http://localhost:${FRONTEND_PORT}"

# Auth token — set at runtime via `yukti set AUTH_TOKEN <value>`
# GQL endpoint
export GQL_URL="${SVC1_URL}/graphql"
export GQL_DIR="${YANTRA_HOME}/contexts/wscloudservices/gql"
