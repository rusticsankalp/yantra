# Base environment — sourced by all contexts
export YANTRA_VERSION="0.1.0"
export YANTRA_STATUS_LINE=""

# Shell prompt integration (used by starship/p10k)
export YANTRA_PROMPT_SHOW="${YANTRA_PROMPT_SHOW:-1}"

# Audit settings
export YANTRA_AUDIT_IGNORE="^(ls|ll|la|cd|pwd|cat|echo|clear|history|exit|yukti log|yukti get|yukti where)$"

# Default colors if not set by instance
export YANTRA_INSTANCE_BG="${YANTRA_INSTANCE_BG:-#262626}"
export YANTRA_INSTANCE_FG="${YANTRA_INSTANCE_FG:-#aaaaaa}"
